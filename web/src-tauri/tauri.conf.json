{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoundLab",
  "version": "0.1.0",
  "identifier": "app.roundlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "RoundLab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/parser"],
    "category": "Utility",
    "shortDescription": "CS2 demo replay workspace",
    "longDescription": "Parse and review CS2 demos locally — no upload, no server."
  },
  "plugins": {}
}
