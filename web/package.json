{
  "name": "roundlab-web",
  "version": "0.1.41",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "geometry:import": "node --no-warnings --experimental-strip-types scripts/import-map-geometry.mts",
    "mechanics:audit": "node --no-warnings --experimental-strip-types scripts/audit-mechanics-match.mts",
    "zones:audit": "node --no-warnings --experimental-strip-types scripts/audit-map-zones.mts",
    "benchmark:analyze": "node --no-warnings --experimental-strip-types scripts/analyze-benchmark-match.mts",
    "benchmark:build": "node --no-warnings --experimental-strip-types scripts/build-benchmark-corpus.mts",
    "benchmark:collect": "node --no-warnings --experimental-strip-types scripts/collect-benchmark-contributions.mts",
    "parser:wasm": "python3 ../scripts/verify-wasm-reproducibility.py --check-tool-only && cd ../parser && cargo build --target wasm32-unknown-unknown --release --lib && wasm-bindgen target/wasm32-unknown-unknown/release/roundlab_parser.wasm --target web --out-dir ../web/src/wasm/roundlab_parser --out-name roundlab_parser --remove-name-section --remove-producers-section",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests-e2e/accessibility.spec.ts --project=chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.2.11",
    "pixi.js": "^8.18.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zstddec": "^0.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
