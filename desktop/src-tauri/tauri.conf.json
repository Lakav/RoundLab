{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoundLab",
  "version": "0.1.29",
  "identifier": "app.roundlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm renderer:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm renderer:build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "RoundLab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/parser",
      "binaries/parser-fallback"
    ],
    "category": "Utility",
    "shortDescription": "CS2 demo replay workspace",
    "longDescription": "Parse and review CS2 demos locally \u2014 no upload, no server."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Lakav/RoundLab/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNDdGQTU5RTk3NUE1RTAKUldUZ3BYWHBXZnBIN0Jmb3orWERNVDhNakh5SXh5akpLQjZDTXhkK3NWbW56Y2ZXMFlRcFAyQ1oK"
    }
  }
}
